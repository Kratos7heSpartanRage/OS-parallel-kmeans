# Word Document Plans
*.docx

# Build artifacts & Binaries
*.o
*.obj
*.exe
*.out
*.so
*.dylib
*.a
bin/
build/
obj/

# Python cache & runtime
__pycache__/
*.py[cod]
*$py.class

# Benchmark and runtime generated files
benchmarks/results/*.csv
benchmarks/results/*.png
!benchmarks/results/.gitkeep

# Large datasets
datasets/*.csv
datasets/*.bin
datasets/*.txt
!datasets/.gitkeep

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Zone.Identifier files (Windows metadata)
*:Zone.Identifier

# Compiled binaries in benchmarks/
benchmarks/benchmark

# Compiler helper files
compile_flags.txt
